# Copy to .env for local testing:  cp .env.example .env  (then `set -a; . ./.env; set +a`)
# In GitHub Actions, set DISCORD_WEBHOOK_URL as a repository *secret* instead.

# Required: your Discord channel webhook URL.
DISCORD_WEBHOOK_URL=

# Optional: a second channel that gets EVERY SWE intern/new-grad role the
# aggregator feeds list, regardless of company (no companies.md/prestige
# filter). Leave unset to skip this feed entirely.
# DISCORD_WEBHOOK_URL_ALL=

# Optional overrides (defaults shown):
# ROLE_TYPES=intern,new_grad      # any of: intern, new_grad
# OFF_SEASON_ONLY=true            # true = drop summer-only internships
# US_CANADA_ONLY=true             # true = only roles in the US or Canada
# INCLUDE_UNKNOWN_LOCATIONS=true  # keep roles with no/ambiguous location
# STALE_POSTED_DAYS=21            # hide the "Posted" field when the board's date
#                                 # is older than this (display only — freshness
#                                 # is decided by dedup, not by board dates)
# DRY_RUN=false                   # true = print, don't send to Discord or save state
# SEED_QUIETLY=true               # true = first run seeds silently (no spam)
# MAX_NOTIFICATIONS_PER_RUN=60

# --- Watch mode (`jobscraper watch`) ---------------------------------------
# The scheduled command. Polls on its own clock instead of waiting to be
# re-invoked, because GitHub's cron is throttled far below what it advertises.
# WATCH_INTERVAL=60           # seconds between aggregator polls (cheap: 304s)
# WATCH_COMPANY_INTERVAL=300  # seconds between full company-ATS sweeps
# WATCH_PRIORITY_INTERVAL=60 # seconds between priority company sweeps
# PRIORITY_COMPANIES=Amazon,Google,Microsoft,Apple,Netflix,Nvidia
# WATCH_DURATION=19800        # seconds to run before exiting (5h30m)
# WATCH_FLUSH_INTERVAL=300    # seconds between state flushes to disk

# --- Dedup -----------------------------------------------------------------
# Collapse postings sharing company+title+location, which catches a board
# reissuing one role under a new requisition id. URL-based dedup is always on.
# Set false to accept a few repeats rather than risk suppressing a real role.
# FINGERPRINT_DEDUP=true
# Drop records for postings no board has listed in this many days (0 = never).
# Keyed on last-seen, so a still-open role is never pruned.
# PRUNE_DELISTED_DAYS=0
